    if(q.opensAt&&n<q.opensAt)return {k:"soon",t:"يبدأ "+fmtDT(q.opensAt)};
    if(q.closesAt&&n>q.closesAt)return {k:"closed",t:"انتهى "+fmtDT(q.closesAt)};
    if(q.single&&r)return {k:"done",t:"أنهيت المحاولة"};
    var a=S.attempts[q.id];
    if(a&&(!r||r.at<a.startedAt)&&(!q.minutes||n<a.startedAt+q.minutes*60000))return {k:"resume",t:"محاولة جارية"};
    if(q.single&&a)return {k:"done",t:"انتهت محاولتك"};
