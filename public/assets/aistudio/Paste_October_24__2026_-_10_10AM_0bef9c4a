    if(!S.students.length){$("#stu-msg").className="msg";$("#stu-msg").textContent="لم يفتح أي حساب المنصة بعد.";S.rep={rows:[]};renderStudents();return}
    S.repLoading=true;$("#stu-msg").className="msg ok";$("#stu-msg").textContent="جارٍ تحميل البيانات...";renderStudents();
    try{
      var ids=S.students.map(function(s){return s.id});
      var prof=await S.user.profiles(ids);ids.forEach(function(id){if(prof[id]&&prof[id].name)S.names[id]=prof[id].name});
      var rows=await Promise.all(ids.map(async function(id){
        var ref=S.db.doc("attendance/"+id);
        var r=await Promise.all([ref.collection("log").get(),ref.collection("results").get(),ref.collection("enrolled").get()]);
        var att={},last=0,enr={},res={};
        r[0].docs.forEach(function(d){var v=d.data()||{};if(v.attended){att[d.id]=v.attended;last=Math.max(last,v.attended)}if(v.opened)last=Math.max(last,v.opened)});
        r[1].docs.forEach(function(d){var v=d.data()||{};res[d.id]=v;last=Math.max(last,v.at||0)});
        r[2].docs.forEach(function(d){enr[d.id]=true});
        return {id:id,att:att,results:res,enr:enr,last:last};
      }));
      S.rep={rows:rows,at:Date.now()};$("#stu-msg").textContent="";
    }catch(e){$("#stu-msg").className="msg";$("#stu-msg").textContent="تعذر تحميل البيانات."}
