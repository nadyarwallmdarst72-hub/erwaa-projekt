<title>منصة إرواء</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600&family=Noto+Kufi+Arabic:wght@500;700&display=swap">
<style>
/* Layout: one phone-width column (max 520px): calendar-first student dashboard, bottom tab bar, and an admin area (students, courses, lessons, quizzes, announcements, teachers, site editor) for staff only. */
:root{
  --bg:#F4F8F7;
  --surface:#FFFFFF;
  --line:#D6E4E1;
  --fg:#16302C;
  --muted:#68807B;
  --accent:#1B8576;
  --accent-soft:#E0F0ED;
  --accent-fg:#FFFFFF;
  --ok:#2E8E45;
  --bad:#D13B3B;
  --scrim:rgba(8,20,18,.5);
  --font-display:'Noto Kufi Arabic','Segoe UI',Tahoma,sans-serif;
  --font-body:'IBM Plex Sans Arabic','Segoe UI',Tahoma,sans-serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0D1817;--surface:#142423;--line:#223937;--fg:#E2EFEC;--muted:#8CA8A3;
    --accent:#3DB8A6;--accent-soft:#16403B;--accent-fg:#06211D;--ok:#52C06B;--bad:#EF6B6B;--scrim:rgba(0,0,0,.6);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0D1817;--surface:#142423;--line:#223937;--fg:#E2EFEC;--muted:#8CA8A3;
  --accent:#3DB8A6;--accent-soft:#16403B;--accent-fg:#06211D;--ok:#52C06B;--bad:#EF6B6B;--scrim:rgba(0,0,0,.6);
  color-scheme:dark;
}
*{box-sizing:border-box}
body{
  background:var(--bg);color:var(--fg);font-family:var(--font-body);font-size:15px;line-height:1.6;direction:rtl;
  padding-block:12px 112px;
  padding-left:max(16px,env(safe-area-inset-left,0px));
  padding-right:max(16px,env(safe-area-inset-right,0px));
}
button,input,select,textarea{font:inherit;color:inherit}
.shell{max-width:520px;margin:0 auto;display:grid;gap:16px}
.top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:4px 2px}
.brand{display:flex;align-items:center;gap:10px;min-width:0}
.logoimg{height:40px;max-width:120px;object-fit:contain;border-radius:6px}
.logo{font-family:var(--font-display);font-weight:700;font-size:22px;color:var(--accent);min-width:0;overflow-wrap:anywhere}
.logo small{display:block;font-family:var(--font-body);font-weight:400;font-size:12px;color:var(--muted)}
.chip{font-size:12px;padding:2px 10px;border-radius:999px;background:var(--accent-soft);color:var(--accent);font-weight:600;white-space:nowrap}
.card{background:var(--surface);border:1px solid var(--line);border-radius:12px;min-width:0}
.card h2,.card h3{font-family:var(--font-display);margin:0}
.pad{padding:16px}
.notice{padding:16px;border:1px solid var(--bad);border-radius:12px;background:var(--surface);color:var(--fg)}
.foot{text-align:center;color:var(--muted);font-size:13px;padding:8px 0;white-space:pre-line}

/* announcements */
.block{padding:16px;display:grid;gap:8px}
.block h3{font-size:17px}
.block p{margin:0;white-space:pre-line;overflow-wrap:anywhere}
.welcome{padding:16px;border-radius:12px;background:var(--accent-soft);display:grid;gap:4px}
.welcome h3{font-family:var(--font-display);font-size:18px;margin:0;color:var(--accent)}
.welcome p{margin:0;white-space:pre-line}

/* calendar */
.cal-head{display:flex;align-items:center;gap:6px;padding:12px 16px;border-bottom:1px solid var(--line)}
.cal-head h2{flex:1;font-size:18px}
.iconbtn{width:38px;height:38px;border-radius:8px;border:0;background:transparent;color:var(--accent);display:grid;place-items:center;cursor:pointer}
.iconbtn:hover{background:var(--accent-soft)}
.todaybtn{border:1px solid var(--accent);color:var(--accent);background:transparent;border-radius:8px;padding:6px 16px;font-weight:600;cursor:pointer;margin-inline-start:6px}
.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px 0;padding:12px 8px 8px;text-align:center}
.wd{color:var(--muted);font-size:13px;padding-bottom:4px}
.day{justify-self:center;width:40px;height:40px;border-radius:50%;border:2px solid transparent;background:transparent;font-variant-numeric:tabular-nums;cursor:pointer;position:relative;padding:0}
.day.done{border-color:var(--ok)}
.day.missed{border-color:var(--bad)}
.day.sel{background:var(--accent-soft)}
.day.today{background:var(--accent-soft);color:var(--accent);font-weight:700}
.day.upcoming::after,.day.todayopen::after{content:"";position:absolute;bottom:3px;left:50%;width:5px;height:5px;margin-left:-2.5px;border-radius:50%;background:var(--accent)}
.day:focus-visible,.row:focus-visible,.tab:focus-visible,.btn:focus-visible,.qopt:focus-visible,.iconbtn:focus-visible,.seg button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.legend{display:flex;flex-wrap:wrap;gap:6px 16px;padding:4px 16px 12px;font-size:12px;color:var(--muted)}
.legend span{display:inline-flex;align-items:center;gap:6px}
.lg{width:12px;height:12px;border-radius:50%;border:2px solid var(--line);display:inline-block}
.lg.ok{border-color:var(--ok)}.lg.bad{border-color:var(--bad)}.lg.dot{border:0;width:6px;height:6px;background:var(--accent)}
.summary{padding:12px 16px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:14px}
.summary b{font-variant-numeric:tabular-nums}
.meter{flex:0 0 96px;height:6px;border-radius:3px;background:var(--accent-soft);overflow:hidden}
.meter i{display:block;height:100%;background:var(--accent)}

/* lists */
.sec-h{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:16px;border-bottom:1px solid var(--line)}
.sec-h h3{font-size:18px;overflow-wrap:anywhere}
.sec-h span{color:var(--muted);font-size:14px}
.row{display:flex;align-items:center;gap:14px;width:100%;padding:14px 16px;background:transparent;border:0;border-bottom:1px solid var(--line);text-align:right;cursor:pointer}
.row:last-child{border-bottom:0}
.row:hover{background:var(--accent-soft)}
.row[disabled]{opacity:.6;cursor:not-allowed}
.row[disabled]:hover{background:transparent}
.rt{flex:1;min-width:0;display:grid}
.rt b{font-weight:600;overflow-wrap:anywhere}
.rt small{color:var(--muted);overflow-wrap:anywhere}
.tick{flex:0 0 32px;width:32px;height:32px;border-radius:50%;background:var(--accent-soft);color:var(--accent-fg);display:grid;place-items:center}
.tick.on{background:var(--accent)}
.chev{color:var(--accent);display:grid}
.empty{padding:20px 16px;color:var(--muted);text-align:center}

/* sheet */
.scrim{position:fixed;inset:0;background:var(--scrim);z-index:20}
.sheet{position:fixed;left:0;right:0;bottom:0;max-width:520px;margin:0 auto;z-index:21;background:var(--surface);border-radius:16px 16px 0 0;border:1px solid var(--line);
  padding:20px max(16px,env(safe-area-inset-left,0px)) calc(20px + env(safe-area-inset-bottom,0px));display:grid;gap:12px;max-height:88%;overflow-y:auto}
.sheet h2{font-family:var(--font-display);font-size:20px;margin:0;overflow-wrap:anywhere}
.sheet .meta{color:var(--muted);font-size:14px}
.state{padding:10px 12px;border-radius:8px;background:var(--accent-soft);font-size:14px}
.state.warn{background:transparent;border:1px dashed var(--line);color:var(--muted)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:0 20px;border-radius:10px;font-weight:600;border:1px solid var(--accent);cursor:pointer;text-decoration:none;background:transparent;color:var(--accent)}
.btn.primary{background:var(--accent);color:var(--accent-fg)}
.btn.danger{border-color:var(--bad);color:var(--bad)}
.btn.small{min-height:36px;padding:0 14px;font-size:14px}
.btn[disabled]{opacity:.45;cursor:not-allowed}
.link{background:none;border:0;color:var(--accent);cursor:pointer;padding:6px 0;font-weight:500}
.link.bad{color:var(--bad)}

/* tabs */
.tabs{position:fixed;left:0;right:0;bottom:0;z-index:10;background:var(--surface);border-top:1px solid var(--line);
  padding:6px max(8px,env(safe-area-inset-left,0px)) calc(6px + env(safe-area-inset-bottom,0px))}
.tabs-in{max-width:520px;margin:0 auto;display:grid;grid-auto-flow:column;grid-auto-columns:1fr}
.tab{display:grid;justify-items:center;align-content:start;gap:2px;padding:6px 2px;background:none;border:0;color:var(--muted);cursor:pointer;font-size:12px;line-height:1.25;border-radius:8px;min-width:0}
.tab span{text-align:center;overflow-wrap:anywhere}
.tab[aria-current="page"]{color:var(--accent);font-weight:600}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(88px + env(safe-area-inset-bottom,0px));z-index:30;background:var(--fg);color:var(--bg);padding:10px 16px;border-radius:10px;font-size:14px;max-width:min(92vw,440px);text-align:center}

/* quizzes */
.badge{font-size:13px;padding:2px 10px;border-radius:999px;background:var(--accent-soft);color:var(--accent);white-space:nowrap;font-variant-numeric:tabular-nums}
.badge.bad{color:var(--bad)}
.qq{border:0;margin:0;padding:16px;border-bottom:1px solid var(--line);display:grid;gap:10px;min-width:0}
.qq:last-of-type{border-bottom:0}
.qq legend{font-weight:600;padding:0;overflow-wrap:anywhere}
.qopt{width:100%;text-align:right;padding:11px 14px;border-radius:10px;border:1px solid var(--line);background:var(--surface);cursor:pointer;overflow-wrap:anywhere}
.qopt.sel{border-color:var(--accent);background:var(--accent-soft)}
.qopt.right{border-color:var(--ok);background:var(--accent-soft)}
.qopt.wrong{border-color:var(--bad)}
.qnote{font-size:13px;color:var(--muted)}
.score{font-family:var(--font-display);font-size:40px;font-weight:700;color:var(--accent);font-variant-numeric:tabular-nums;text-align:center}
.qtimer{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;padding:10px 16px;background:var(--accent);color:var(--accent-fg);font-weight:600;font-variant-numeric:tabular-nums;border-radius:12px 12px 0 0;text-align:center}
.qtimer.low{background:var(--bad);color:#fff}

/* certificates */
.cert{border:2px solid var(--accent);border-radius:12px;padding:6px;background:var(--surface)}
.cert-in{border:1px solid var(--accent);border-radius:8px;padding:22px 14px;text-align:center;display:grid;gap:10px}
.cert-brand{font-family:var(--font-display);color:var(--accent);font-size:16px}
.cert-title{font-family:var(--font-display);font-size:26px;font-weight:700}
.cert-name{font-family:var(--font-display);font-size:24px;color:var(--accent);padding:6px 0;border-bottom:1px solid var(--line);overflow-wrap:anywhere}
.cert-body{margin:0;overflow-wrap:anywhere}
.cert-meta{display:flex;justify-content:space-between;gap:8px;color:var(--muted);font-size:13px}
.cert-sign{font-weight:600}
.cert-sign small{display:block;color:var(--muted);font-weight:400}
.prog{display:grid;gap:6px;padding:12px 16px}
.prog .line{display:flex;justify-content:space-between;gap:12px;font-size:14px}
.bar{display:block;height:6px;border-radius:3px;background:var(--accent-soft);overflow:hidden}
.bar i{display:block;height:100%;background:var(--accent)}
.bar.inl{display:inline-block;width:56px;vertical-align:middle;margin-inline-start:8px}
.certcv{width:100%;height:auto;display:block;border:1px solid var(--line);border-radius:8px;background:#fff}
.certcv.edit{touch-action:none;cursor:grab}
.pj-text{white-space:pre-line;overflow-wrap:anywhere;margin:0}
.fb{background:var(--accent-soft);padding:10px 12px;border-radius:8px;display:grid;gap:4px}

/* admin */
.seg{display:flex;flex-wrap:wrap;gap:6px}
.seg button{padding:8px 14px;border:1px solid var(--line);border-radius:999px;background:var(--surface);cursor:pointer;color:var(--muted);font-weight:500}
.seg button[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-fg)}
.form{display:grid;gap:12px;padding:16px}
.form label{display:grid;gap:4px;font-size:14px;color:var(--muted)}
.form label.chk{display:flex;align-items:center;gap:10px}
.form input,.form select,.form textarea,.card select{background:var(--bg);color:var(--fg);border:1px solid var(--line);border-radius:8px;padding:10px 12px;min-height:44px;width:100%;min-width:0}
.form textarea{min-height:84px;resize:vertical}
.form input[type=checkbox]{width:20px;min-height:20px;accent-color:var(--accent)}
.form input[type=color]{padding:2px;min-height:44px}
.form input:focus-visible,.form select:focus-visible,.form textarea:focus-visible,.card select:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
.form .actions{display:flex;flex-wrap:wrap;gap:8px}
.msg{margin:0;font-size:14px;color:var(--bad)}
.msg.ok{color:var(--ok)}
.item{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px;border-bottom:1px solid var(--line)}
.item:last-child{border-bottom:0}
.ia{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
.opt{display:flex;align-items:center;gap:10px}
.opt input[type=radio]{width:20px;min-height:20px;flex:0 0 20px;accent-color:var(--accent)}
.fieldset-q{border:1px solid var(--line);border-radius:10px;padding:12px;display:grid;gap:10px;margin:0;min-width:0}
.fieldset-q legend{padding:0 6px;font-weight:600;color:var(--fg)}
.tw{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:14px}
th,td{padding:8px 12px;text-align:right;border-bottom:1px solid var(--line);white-space:nowrap;font-variant-numeric:tabular-nums}
th{color:var(--muted);font-weight:600}
td .link{padding:0;font-weight:600}
.tiles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.tile{padding:12px 14px;border:1px solid var(--line);border-radius:10px;background:var(--surface)}
.tile b{display:block;font-family:var(--font-display);font-size:26px;color:var(--accent);font-variant-numeric:tabular-nums}
.tile span{color:var(--muted);font-size:13px}
.hint{color:var(--muted);font-size:13px;margin:0}
.swatches{display:flex;gap:8px;flex-wrap:wrap}
.sw{width:34px;height:34px;border-radius:50%;border:2px solid var(--line);cursor:pointer;padding:0}
.logo-prev{display:flex;align-items:center;gap:12px}
.logo-prev img{height:44px;max-width:140px;object-fit:contain;border-radius:6px;border:1px solid var(--line);background:#fff}
.chks{display:grid;gap:6px;padding:8px 0}
.chks label{display:flex;align-items:center;gap:10px;color:var(--fg);font-size:15px}
@media (prefers-reduced-motion:no-preference){.sheet{animation:up .18s ease-out}@keyframes up{from{transform:translateY(24px);opacity:0}to{transform:none;opacity:1}}}
</style>
<style id="ov"></style>

<div class="shell" id="shell" lang="ar" dir="rtl">
  <header class="top">
    <div class="brand">
      <img id="logoimg" class="logoimg" alt="" hidden>
      <div class="logo"><span id="sname">إرواء</span><small id="stag">المنصة التعليمية</small></div>
    </div>
    <span class="chip" id="rolechip" hidden></span>
  </header>
  <div class="notice" id="notice" hidden></div>

  <main id="main">
    <section id="v-cal" style="display:grid;gap:16px">
      <div id="blocks" style="display:grid;gap:12px"></div>
      <div class="card" id="cal"></div>
      <div class="card" id="day"></div>
      <div class="card" id="cont" hidden></div>
    </section>

    <section id="v-courses" hidden style="display:grid;gap:16px">
      <div class="card pad" id="namehint" hidden>
        <p class="hint" style="margin-bottom:8px">اكتب اسمك الكامل ليظهر في شهادتك وفي كشوف المشرفين.</p>
        <button type="button" class="btn small primary" data-act="tab" data-t="certs">إضافة الاسم</button>
      </div>
      <div id="coursebox"></div>
    </section>

    <section id="v-quiz" hidden style="display:grid;gap:16px"><div id="quizbox"></div></section>

    <section id="v-certs" hidden style="display:grid;gap:16px">
      <div class="card form" id="namecard">
        <h3>اسمك على الشهادة</h3>
        <label for="nm-in">الاسم الكامل<input id="nm-in" autocomplete="name"></label>
        <div class="actions"><button type="button" class="btn small primary" data-act="savename">حفظ الاسم</button></div>
      </div>
      <div id="certbox" style="display:grid;gap:16px"></div>
    </section>

    <section id="v-projects" hidden style="display:grid;gap:16px">
      <div id="pnewbar"><button type="button" class="btn primary" data-act="pnew">مشروع جديد</button></div>
      <form id="pf" class="card form" autocomplete="off" hidden>
        <h3 id="pf-h">مشروع جديد</h3>
        <label for="pf-title">عنوان المشروع<input id="pf-title" maxlength="120"></label>
        <label for="pf-course">الدورة<select id="pf-course"></select></label>
        <label for="pf-text">وصف المشروع<textarea id="pf-text" maxlength="4000" style="min-height:160px"></textarea></label>
        <label for="pf-link">رابط المشروع (اختياري، مثل Google Drive أو GitHub)<input id="pf-link" type="url" inputmode="url" dir="ltr" placeholder="https://"></label>
        <div class="actions">
          <button class="btn primary" type="submit" id="pf-save">تسليم المشروع</button>
          <button class="btn" type="button" data-act="pcancel">إلغاء</button>
        </div>
        <p class="msg" id="pf-msg" role="status"></p>
      </form>
      <div id="plist" style="display:grid;gap:16px"></div>
    </section>

    <section id="v-admin" hidden style="display:grid;gap:16px">
      <div class="seg" id="aseg" role="group" aria-label="أقسام الإدارة"></div>

      <div id="a-students" style="display:grid;gap:16px">
        <div class="card form">
          <h3>الطلاب ونسب الحضور</h3>
          <label for="sf-course">الدورة<select id="sf-course"></select></label>
          <div class="actions">
            <button class="btn small" type="button" data-act="stuload" id="stu-load">تحديث</button>
            <button class="btn small" type="button" data-act="csv" id="stu-csv" hidden>تصدير CSV</button>
            <button class="btn small primary" type="button" data-act="issueall" id="stu-issue" hidden></button>
          </div>
          <p class="msg" id="stu-msg" role="status"></p>
        </div>
        <div id="stu-out" style="display:grid;gap:16px"></div>
      </div>

      <div id="a-courses" hidden style="display:grid;gap:16px">
        <form id="cf" class="card form" autocomplete="off">
          <h3 id="cf-h">إضافة دورة</h3>
          <label for="cf-title">اسم الدورة<input id="cf-title" required></label>
          <label for="cf-desc">وصف مختصر<input id="cf-desc"></label>
          <label for="cf-teacher">اسم المعلم المشرف (للعرض)<input id="cf-teacher"></label>
          <label for="cf-minatt">أقل نسبة حضور للشهادة %<input id="cf-minatt" type="number" min="0" max="100" inputmode="numeric" placeholder="80"></label>
          <label for="cf-minscore">أقل معدل اختبارات للشهادة %<input id="cf-minscore" type="number" min="0" max="100" inputmode="numeric" placeholder="60"></label>
          <div class="actions">
            <button class="btn primary" type="submit" id="cf-save">حفظ الدورة</button>
            <button class="btn" type="button" id="cf-cancel" hidden>إلغاء التعديل</button>
          </div>
          <p class="msg" id="cf-msg" role="status"></p>
        </form>
        <div class="card" id="cf-list"></div>
      </div>

      <div id="a-lessons" hidden style="display:grid;gap:16px">
        <form id="lf" class="card form" autocomplete="off">
          <h3 id="lf-h">إضافة درس</h3>
          <label for="lf-title">عنوان الدرس<input id="lf-title" required></label>
          <label for="lf-course">الدورة<select id="lf-course"></select></label>
          <label for="lf-date">تاريخ الدرس<input id="lf-date" type="date" required></label>
          <label for="lf-url">رابط الفيديو على يوتيوب<input id="lf-url" type="url" inputmode="url" dir="ltr" placeholder="https://youtu.be/..."></label>
          <div class="actions">
            <button class="btn primary" type="submit" id="lf-save">حفظ الدرس</button>
            <button class="btn" type="button" id="lf-cancel" hidden>إلغاء التعديل</button>
          </div>
          <p class="msg" id="lf-msg" role="status"></p>
        </form>
        <div class="card" id="lf-list"></div>
      </div>

      <div id="a-quizzes" hidden style="display:grid;gap:16px">
        <div class="card form" id="qb"></div>
        <div class="card" id="ql"></div>
      </div>

      <div id="a-projects" hidden style="display:grid;gap:16px">
        <div class="card form">
          <h3>مشاريع الطلاب</h3>
          <label for="pj-course">الدورة<select id="pj-course"></select></label>
          <label for="pj-status">الحالة<select id="pj-status">
            <option value="all">كل الحالات</option><option value="submitted">بانتظار المراجعة</option><option value="returned">مطلوب تعديل</option><option value="reviewed">تمت المراجعة</option>
          </select></label>
