  function nameFor(id,idx){var s=S.students.filter(function(x){return x.id===id})[0];return (s&&s.name)||S.names[id]||("حساب "+(idx+1))}
  function dueIn(cf,r){
    return S.lessons.filter(function(l){
      if(l.date>todayKey)return false;
      if(cf!=="all")return l.courseId===cf&&!!r.enr[cf];
      if(l.courseId)return !!r.enr[l.courseId]&&manage(l.courseId);
      return S.owner;
    });
  }
  function scopeLessons(cf){
    return S.lessons.filter(function(l){return l.date<=todayKey&&(cf!=="all"?l.courseId===cf:(l.courseId?manage(l.courseId):S.owner))}).sort(function(a,b){return a.date<b.date?-1:1});
  }
  function rowsIn(cf){
    if(!S.rep)return [];
    return S.rep.rows.filter(function(r){
      if(cf!=="all")return !!r.enr[cf];
      return S.owner||Object.keys(r.enr).some(manage);
    });
  }
  function quizAvg(r,cf){
    var qs=S.quizzes.filter(function(q){return cf!=="all"?q.courseId===cf:(q.courseId?(!!r.enr[q.courseId]&&manage(q.courseId)):S.owner)});
    var sum=0,n=0;qs.forEach(function(q){var x=r.results[q.id];if(x&&x.total){sum+=x.best/x.total;n++}});
    return n?Math.round(sum*100/n):null;
  }
