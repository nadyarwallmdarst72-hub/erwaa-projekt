        Promise.all(rowsIn(cf).filter(function(r){return courseStats(cf,r).ok&&!certOf(cf,r.id)}).map(function(r){return issueCert(cf,r.id)}))
          .then(function(){toast("تم إصدار الشهادات")}).catch(function(){toast("تعذر إصدار بعض الشهادات")});break;
      case "cedit":var c=courseOf(id);if(!c)break;
        S.editC=id;$("#cf-title").value=c.title||"";$("#cf-desc").value=c.desc||"";$("#cf-teacher").value=c.teacher||"";
        $("#cf-minatt").value=c.minAtt===undefined?"":c.minAtt;$("#cf-minscore").value=c.minScore===undefined?"":c.minScore;
        $("#cf-h").textContent="تعديل الدورة";$("#cf-cancel").hidden=false;$("#cf-msg").textContent="";$("#cf-title").focus();window.scrollTo(0,0);break;
      case "c":S.delC=id;renderAdminLists();break;
      case "cx":S.delC=null;renderAdminLists();break;
      case "c2":S.delC=null;delDoc("courses/"+id,"تم حذف الدورة");break;
      case "ledit":var l=S.lessons.filter(function(x){return x.id===id})[0];if(!l)break;
        S.editL=id;$("#lf-title").value=l.title||"";$("#lf-course").value=l.courseId||"";$("#lf-date").value=l.date||"";$("#lf-url").value=l.url||"";
        $("#lf-h").textContent="تعديل الدرس";$("#lf-cancel").hidden=false;$("#lf-msg").textContent="";$("#lf-title").focus();window.scrollTo(0,0);break;
      case "l":S.delL=id;renderAdminLists();break;
      case "lx":S.delL=null;renderAdminLists();break;
      case "l2":S.delL=null;delDoc("lessons/"+id,"تم حذف الدرس");break;
      case "qadd":S.draft.qs.push(newQ());renderBuilder();break;
      case "qrm":S.draft.qs.splice(+t.dataset.i,1);renderBuilder();break;
      case "qsave":saveQuiz();break;
      case "qcancel":S.draft=newDraft();renderBuilder();break;
      case "qedit":var q=quizById(id);if(!q)break;
        S.draft={id:id,title:q.title,courseId:q.courseId||"",minutes:q.minutes?String(q.minutes):"",opens:q.opensAt?toInput(q.opensAt):"",closes:q.closesAt?toInput(q.closesAt):"",single:!!q.single,
          qs:(q.questions||[]).map(function(it){var o=it.options.slice();while(o.length<4)o.push("");return {q:it.q,opts:o,ans:it.answer}})};
        renderBuilder();$("#qb").scrollIntoView({block:"start"});break;
      case "q":S.delQ=id;renderAdminLists();break;
      case "qx":S.delQ=null;renderAdminLists();break;
      case "q2":S.delQ=null;delDoc("quizzes/"+id,"تم حذف الاختبار");break;
      case "bedit":var b=S.blocks.filter(function(x){return x.id===id})[0];if(!b)break;
        S.editB=id;$("#bf-title").value=b.title||"";$("#bf-text").value=b.text||"";$("#bf-label").value=b.linkLabel||"";$("#bf-url").value=b.linkUrl||"";$("#bf-course").value=b.courseId||"";
        $("#bf-h").textContent="تعديل الإعلان";$("#bf-cancel").hidden=false;$("#bf-title").focus();window.scrollTo(0,0);break;
      case "b":S.delB=id;renderAdminLists();break;
      case "bx":S.delB=null;renderAdminLists();break;
      case "b2":S.delB=null;delDoc("blocks/"+id,"تم حذف الإعلان");break;
      case "tedit":var tt=S.teachers.filter(function(x){return x.id===id})[0];S.tch={id:id,courses:tt?(tt.courses||[]).slice():[]};renderTeachers();break;
      case "tclose":S.tch=null;renderTeachers();break;
      case "tsave":
        if(S.tch){var tid=S.tch.id,tc=S.tch.courses.slice();S.tch=null;
          S.db.doc("teachers/"+tid).set({courses:tc,at:Date.now()}).then(function(){toast("تم حفظ تعيين المعلم")}).catch(function(){toast("تعذر الحفظ")})}
        break;
      case "tremove":S.tch=null;delDoc("teachers/"+id,"أُزيلت صفة المعلم");break;
      case "swatch":editDraft(function(d){d.accent=t.dataset.c});fillSite();break;
      case "logoclear":editDraft(function(d){d.logo=""});break;
      case "sitesave":saveSite();break;
      case "cpbgclear":ensureDraft();S.bgDraft="";paintPreview();break;
      case "cplayout":ensureDraft();S.sdraft.cert.layout=JSON.parse(JSON.stringify(DEF.cert.layout));syncCertCtrls();paintPreview();break;
      case "pnew":openProjForm(null);break;
      case "pedit":openProjForm(id);break;
      case "pcancel":closeProjForm();break;
      case "pdel":S.delP=id;renderProjects();break;
      case "pdelx":S.delP=null;renderProjects();break;
      case "pdel2":S.delP=null;delDoc("attendance/"+S.uid+"/projects/"+id,"تم حذف المشروع");break;
      case "pjload":S.pAll=null;loadProjects();break;
      case "pjopen":openReview(t.dataset.u,id);break;
      case "prclose":S.pSel=null;$("#prd").hidden=true;break;
      case "prsave":saveReview();break;
      case "sitereset":S.sdraft=null;S.sdirty=false;S.bgDraft=null;applySite();fillSite();render();$("#site-msg").textContent="";break;
    }
  });
  document.addEventListener("input",function(e){
    var t=e.target;
    if(t.id==="cp-size"){setLayout(S.celSel,{size:+t.value});$("#cp-size-o").textContent=t.value+"px";paintPreview();return}
    if(t.id==="cp-color"){setLayout(S.celSel,{color:t.value});paintPreview();return}
    if(t.dataset&&t.dataset.s){var v=t.value;editDraft(function(d){setP(d,t.dataset.s,v)});return}
    if(!S.draft)return;
    if(t.id==="qb-title"){S.draft.title=t.value;return}
    var f=t.dataset&&t.dataset.f;if(!f)return;var i=+t.dataset.i,j=+t.dataset.j;
    if(f==="q")S.draft.qs[i].q=t.value;else if(f==="opt")S.draft.qs[i].opts[j]=t.value;
    else if(f==="meta")S.draft[t.dataset.k]=t.type==="checkbox"?t.checked:t.value;
  });
  document.addEventListener("change",function(e){
    var t=e.target;
    if(t.id==="ss-logo"){readLogo(t.files&&t.files[0]);t.value="";return}
    if(t.id==="cp-bg"){readBg(t.files&&t.files[0]);t.value="";return}
    if(t.id==="cp-el"){S.celSel=t.value;syncCertCtrls();paintPreview();return}
    if(t.id==="cp-on"){setLayout(S.celSel,{on:t.checked});paintPreview();return}
    if(t.dataset&&t.dataset.s){var v=t.value;editDraft(function(d){setP(d,t.dataset.s,v)});return}
    if(t.dataset&&t.dataset.act==="tcb"&&S.tch){var c=t.dataset.c,ix=S.tch.courses.indexOf(c);if(t.checked&&ix<0)S.tch.courses.push(c);if(!t.checked&&ix>=0)S.tch.courses.splice(ix,1);return}
    if(t.id==="qb-course"&&S.draft){S.draft.courseId=t.value;return}
    if(t.id==="sf-course"){S.repCourse=t.value;renderStudents();return}
    if(t.id==="pj-course"){S.pCourse=t.value;renderProjAdmin();return}
    if(t.id==="pj-status"){S.pStat=t.value;renderProjAdmin();return}
    if(t.dataset&&t.dataset.f==="ans"&&S.draft)S.draft.qs[+t.dataset.i].ans=+t.dataset.j;
  });
  document.addEventListener("keydown",function(e){if(e.key==="Escape"&&S.sheet){S.sheet=null;renderSheet()}});
  setInterval(function(){if(S.tab==="quiz"&&!S.quiz)renderQuizzes()},30000);

  /* ---------- boot ---------- */
  async function boot(){
    S.draft=newDraft();
    applySite();render();
    if(!window.claude||!window.claude.use){showNotice("افتح هذه الصفحة من حسابك على claude.ai لتعمل الدروس والحضور.");return}
    var r=await Promise.all([window.claude.use("db"),window.claude.use("user")]);
    S.db=r[0];S.user=r[1];
    S.uid=S.user?await S.user.id():null;
    S.admin=S.user?await S.user.canEdit():false;
    S.owner=S.user?await S.user.isOwner():false;
    if(!S.db||!S.uid){showNotice("سجّل الدخول إلى حسابك لعرض جدولك وتسجيل حضورك.");return}
    var onErr=function(e){console.error(e);showNotice("تعذر تحميل البيانات. أعد فتح الصفحة.")};
    $("#pf").addEventListener("submit",saveProject);
    if(S.admin){
      $("#cf").addEventListener("submit",saveCourse);
      $("#cf-cancel").addEventListener("click",function(){resetCourseForm(false)});
      $("#lf").addEventListener("submit",saveLesson);
      $("#lf-cancel").addEventListener("click",function(){resetLessonForm(false)});
      $("#bf").addEventListener("submit",saveBlock);
      $("#bf-cancel").addEventListener("click",function(){resetBlockForm(false)});
      renderBuilder();
    }
    var coll=function(name,key){S.db.collection(name).onSnapshot(function(s){S[key]=s.docs.map(function(d){return Object.assign({id:d.id},d.data())});render()},onErr)};
    S.db.doc("settings/site").onSnapshot(function(s){
      S.site=s.exists?s.data():null;
      if(!S.sdirty){S.sdraft=null;applySite();if(S.siteBuilt)fillSite()}
      render();
    },onErr);
    S.db.doc("settings/certbg").onSnapshot(function(s){S.certBg=s.exists?(s.data().data||""):"";render()},onErr);
    coll("courses","courses");coll("lessons","lessons");coll("quizzes","quizzes");coll("blocks","blocks");
    var mine=S.db.doc("attendance/"+S.uid);
    mine.collection("enrolled").onSnapshot(function(s){
      S.enrolled={};s.docs.forEach(function(d){S.enrolled[d.id]=d.data()});
      if(!S.tabInit&&!s.metadata.fromCache){S.tabInit=true;if(!s.size&&!S.admin)S.tab="courses"}
      render();
    },onErr);
    mine.collection("log").onSnapshot(function(s){S.log={};s.docs.forEach(function(d){S.log[d.id]=d.data()});render()},onErr);
    mine.collection("results").onSnapshot(function(s){S.results={};s.docs.forEach(function(d){S.results[d.id]=d.data()});render()},onErr);
    mine.collection("projects").onSnapshot(function(s){S.projects={};s.docs.forEach(function(d){S.projects[d.id]=d.data()});render()},onErr);
    S.db.doc("reviews/"+S.uid).collection("items").onSnapshot(function(s){S.reviews={};s.docs.forEach(function(d){S.reviews[d.id]=d.data()});render()},onErr);
    mine.collection("attempts").onSnapshot(function(s){S.attempts={};s.docs.forEach(function(d){S.attempts[d.id]=d.data()});if(S.tab==="quiz"&&!S.quiz)renderQuizzes()},onErr);
    var cq=S.admin?S.db.collection("certificates"):S.db.collection("certificates").where("uid","==",S.uid);
    cq.onSnapshot(function(s){S.certs=s.docs.map(function(d){return Object.assign({id:d.id},d.data())});render()},onErr);
    S.db.doc("teachers/"+S.uid).onSnapshot(function(s){S.teachDoc=s.exists?s.data():null;render();ensureStudents()},onErr);
    S.db.doc("students/"+S.uid).onSnapshot(function(s){
      if(!s.exists){S.db.doc("students/"+S.uid).set({joinedAt:Date.now(),name:""}).catch(function(){});return}
      S.me=s.data();var inp=$("#nm-in");if(inp&&document.activeElement!==inp)inp.value=S.me.name||"";
      render();
    },onErr);
    if(S.admin){
      S.db.collection("students").onSnapshot(function(s){
        S.students=s.docs.map(function(d){return Object.assign({id:d.id},d.data())});
        if(S.user&&S.user.profiles)S.user.profiles(S.students.map(function(x){return x.id})).then(function(p){Object.keys(p).forEach(function(k){if(p[k].name)S.names[k]=p[k].name});if(S.tab==="admin"&&S.atab==="teachers")renderTeachers()});
        render();ensureStudents();
      },onErr);
    }
    if(S.owner)S.db.collection("teachers").onSnapshot(function(s){S.teachers=s.docs.map(function(d){return Object.assign({id:d.id},d.data())});if(S.tab==="admin"&&S.atab==="teachers")renderTeachers()},onErr);
  }
  boot();
})();
</script>