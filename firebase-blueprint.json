{
  "entities": {
    "User": {
      "title": "User",
      "description": "User accounts, student admission requests, and roles",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user identifier" },
        "email": { "type": "string", "description": "User email address" },
        "name": { "type": "string", "description": "Full display name" },
        "role": { "type": "string", "enum": ["owner", "teacher", "student"], "description": "User role in the platform" },
        "status": { "type": "string", "enum": ["active", "pending", "suspended"], "description": "Account admission status" },
        "joinedAt": { "type": "number", "description": "Join timestamp in ms" },
        "lastLoginAt": { "type": "number", "description": "Last login timestamp" },
        "accountCode": { "type": "string", "description": "Account secret access code" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "bio": { "type": "string", "description": "User biography or specialty" },
        "avatar": { "type": "string", "description": "Avatar icon or image URL" }
      },
      "required": ["id", "email", "name", "role", "status", "joinedAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Platform announcements broadcast across devices",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique announcement ID" },
        "title": { "type": "string", "description": "Announcement title" },
        "body": { "type": "string", "description": "Announcement content" },
        "type": { "type": "string", "description": "Announcement type" },
        "urgent": { "type": "boolean", "description": "Urgent priority flag" },
        "at": { "type": "number", "description": "Publish timestamp" },
        "pinned": { "type": "boolean", "description": "Pinned to top" },
        "author": { "type": "string", "description": "Author name" },
        "authorRole": { "type": "string", "description": "Author role" }
      },
      "required": ["id", "title", "body", "type", "at"]
    },
    "ScientificQuestion": {
      "title": "ScientificQuestion",
      "description": "Academic inquiries and student questions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Question identifier" },
        "uid": { "type": "string", "description": "Author student ID" },
        "authorName": { "type": "string", "description": "Author display name" },
        "courseId": { "type": "string", "description": "Related course or subject ID" },
        "courseTitle": { "type": "string", "description": "Related course title" },
        "title": { "type": "string", "description": "Question subject" },
        "content": { "type": "string", "description": "Question text" },
        "createdAt": { "type": "number", "description": "Creation timestamp" },
        "status": { "type": "string", "enum": ["open", "resolved"], "description": "Question status" }
      },
      "required": ["id", "uid", "authorName", "title", "content", "createdAt", "status"]
    },
    "Course": {
      "title": "Course",
      "description": "Courses and academic subjects",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Course ID" },
        "title": { "type": "string", "description": "Course title" },
        "desc": { "type": "string", "description": "Course description" },
        "teacher": { "type": "string", "description": "Assigned teacher" },
        "type": { "type": "string", "description": "course or subject" }
      },
      "required": ["id", "title"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Lectures, dates, videos, and exercises",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Lesson ID" },
        "title": { "type": "string", "description": "Lesson title" },
        "courseId": { "type": "string", "description": "Course ID" },
        "date": { "type": "string", "description": "Date YYYY-MM-DD" },
        "url": { "type": "string", "description": "Video URL" },
        "exercises": { "type": "array", "description": "Exercises for this lecture" }
      },
      "required": ["id", "title", "courseId", "date"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Tests and quizzes with multiple choice questions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Quiz ID" },
        "title": { "type": "string", "description": "Quiz title" },
        "courseId": { "type": "string", "description": "Course ID" },
        "questions": { "type": "array", "description": "Questions array" }
      },
      "required": ["id", "title", "questions"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Collection of user accounts, applications, and admission requests"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Platform announcements and news"
    },
    "/questions/{questionId}": {
      "schema": { "$ref": "#/entities/ScientificQuestion" },
      "description": "Academic forum questions and answers"
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Training courses and academic subjects"
    },
    "/lessons/{lessonId}": {
      "schema": { "$ref": "#/entities/Lesson" },
      "description": "Lectures, materials, and exercises"
    },
    "/quizzes/{quizId}": {
      "schema": { "$ref": "#/entities/Quiz" },
      "description": "Academic quizzes and tests"
    }
  }
}
