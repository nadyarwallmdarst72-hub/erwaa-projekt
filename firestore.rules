rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User accounts and admissions requests
    match /users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.email is string
                    && request.resource.data.name is string;
      allow update, delete: if true;
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    // Scientific Questions & Discussions
    match /questions/{questionId} {
      allow read: if true;
      allow write: if true;
    }

    // Site Configuration & Identity Settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /site_settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Courses & Subjects
    match /courses/{courseId} {
      allow read: if true;
      allow write: if true;
    }

    // Lessons & Lectures (including exercises)
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if true;
    }

    // Quizzes & Tests
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if true;
    }

    // Attendance records
    match /attendance/{recordId} {
      allow read: if true;
      allow write: if true;
    }

    // Quiz Results
    match /quiz_results/{resultId} {
      allow read: if true;
      allow write: if true;
    }

    // Certificates
    match /certificates/{certId} {
      allow read: if true;
      allow write: if true;
    }

    // Resource Center / File Bank & Booklets
    match /resources/{resId} {
      allow read: if true;
      allow write: if true;
    }

    // Interactive Lesson Comments & Q&A
    match /lesson_comments/{commentId} {
      allow read: if true;
      allow write: if true;
    }

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
